{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iqmindware.com/schemas/website-evidence-slice.schema.json",
  "title": "IQ Mindware website evidence slice",
  "type": "object",
  "required": ["registry_version", "status", "records"],
  "properties": {
    "registry_version": {"type": "string"},
    "status": {"type": "string"},
    "review_cutoff": {"type": "string", "format": "date"},
    "scope": {"type": "string"},
    "display_policy": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_card_id",
          "public_name",
          "component_ids",
          "measurement_ids",
          "claim_ids",
          "evidence_profile",
          "supported_public_claim",
          "required_boundary",
          "review_status"
        ],
        "properties": {
          "evidence_card_id": {"type": "string", "minLength": 1},
          "public_name": {"type": "string", "minLength": 1},
          "component_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "measurement_ids": {"type": "array", "items": {"type": "string"}},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_profile": {
            "type": "object",
            "required": ["scientific_basis", "exact_implementation", "training_benefit", "workflow_transfer"],
            "additionalProperties": {
              "type": "object",
              "required": ["level", "label", "summary"],
              "properties": {
                "level": {"type": "string"},
                "label": {"type": "string"},
                "summary": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "supported_public_claim": {"type": "string"},
          "required_boundary": {"type": "string"},
          "review_status": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
