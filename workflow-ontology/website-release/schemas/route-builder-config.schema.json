{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iqmindware.com/schemas/route-builder-config.schema.json",
  "title": "IQ Mindware route builder configuration",
  "type": "object",
  "required": ["config_version", "status", "questions", "route_rules", "selection_policy", "eligibility_policy"],
  "properties": {
    "config_version": {"type": "string"},
    "status": {"type": "string"},
    "purpose": {"type": "string"},
    "data_policy": {"type": "object"},
    "questions": {"type": "array", "minItems": 1},
    "route_rules": {"type": "array", "minItems": 1},
    "selection_policy": {"type": "object"},
    "eligibility_policy": {"type": "object"}
  },
  "additionalProperties": false
}
